// SPDX-License-Identifier: GPL-2.0-or-later
// Native-resolution TAA: unjitter, motion reprojection, depth rejection and neighborhood
// clipping. History contains scene RGB and depth in alpha; HUD never enters the history.
#version 450
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D color_tex;
layout(binding = 1) uniform sampler2D depth_tex;
layout(binding = 2) uniform sampler2D motion_tex;
layout(binding = 3) uniform sampler2D history_tex;
layout(binding = 4, rgba16f) uniform writeonly image2D result_img;
layout(binding = 5, rgba32f) uniform writeonly image2D next_history;
layout(binding = 6, rgba16f) uniform writeonly image2D diagnostic_img;
layout(push_constant) uniform Params {
    vec2 jitter;
    uint reset_history; // bit 0: no history; bits 8-15: sparkle filter, half percent (0 = off, 100 = 200%); bits 16-23: detail hold, percent
    uint pad; // bits 0-7: diagnostic output; 8-15: A/B switches; 16-23: history loss of changed patches (percent); 24: view-projection depth; 25: 8-bit scene; 26-31: spatial edge smoothing of low-history pixels (0..63)
    vec4 proj;
    vec4 prev_proj;
    vec4 previous_z; // view-projection mode: the game's viewport (x scale, y scale, x offset, y offset)
    mat4 reproject; // view-projection mode (pad bit 24): previous VP * inverse(current VP)
};

vec4 fetchLinear(sampler2D tex, vec2 position) {
    ivec2 p = ivec2(floor(position));
    vec2 f = fract(position);
    ivec2 bound = textureSize(tex, 0) - 1;
    return mix(mix(texelFetch(tex, clamp(p, ivec2(0), bound), 0),
                   texelFetch(tex, clamp(p + ivec2(1,0), ivec2(0), bound), 0), f.x),
               mix(texelFetch(tex, clamp(p + ivec2(0,1), ivec2(0), bound), 0),
                   texelFetch(tex, clamp(p + ivec2(1,1), ivec2(0), bound), 0), f.x), f.y);
}

// Catmull-Rom weights for the 4x4 taps around a continuous position (`f`: its fraction). Bilinear
// resampling of the history every frame blurs a moving picture; this keeps it sharp. The taps are
// read once in the passes below and shared with the other users of the same texels.
void catmullRomWeights(vec2 f, out float wx[4], out float wy[4]) {
    vec2 f2 = f * f, f3 = f2 * f;
    vec2 w0 = -0.5 * f3 + f2 - 0.5 * f;
    vec2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
    vec2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
    vec2 w3 = 0.5 * f3 - 0.5 * f2;
    wx = float[4](w0.x, w1.x, w2.x, w3.x);
    wy = float[4](w0.y, w1.y, w2.y, w3.y);
}

// Compare depths in the SAME camera, with tolerance proportional to view distance.
// Raw device depth is nonlinear; a constant epsilon merges unrelated distant surfaces.
float expectedPreviousDepth(float depth, vec2 source, ivec2 size) {
    if (depth >= 1.0) return 1.0;
    vec2 uv = (source + 0.5 - jitter) / vec2(size);
    vec2 ndc = vec2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    if ((pad & (1u << 24)) != 0u) {
        // God of War III: one matrix from this frame's clip space to the previous one, through
        // the game's viewport (its scale signs carry the screen's axis directions).
        // proj.xy: the depth scale and offset (depth = offset + scale * clip z / w).
        vec4 previous = reproject * vec4((source + 0.5 - jitter - previous_z.zw) / previous_z.xy,
                                         (depth - proj.y) / proj.x, 1.0);
        if (previous.w <= 1e-6) return -1.0;
        return proj.y + proj.x * previous.z / previous.w;
    }
    float z = proj.w / min(depth - proj.z, -1e-8);
    float prev_z = dot(previous_z, vec4(ndc * z / proj.xy, z, 1.0));
    if (prev_z <= 0.0) return -1.0;
    return prev_proj.z + prev_proj.w / prev_z;
}

// Depth must be unjittered too. A nearest sample on a sloping surface moves in depth
// as Halton changes, even with a stationary camera. Use the smaller one-sided slope
// to avoid extrapolating across a silhouette or a foreground/background discontinuity.
float depthSlope(float depth, ivec2 source, ivec2 axis, ivec2 size) {
    float left = depth - texelFetch(depth_tex, clamp(source - axis, ivec2(0), size-1), 0).r;
    float right = texelFetch(depth_tex, clamp(source + axis, ivec2(0), size-1), 0).r - depth;
    float slope = abs(left) < abs(right) ? left : right;
    return abs(slope) <= max(2e-7, abs(proj.z-depth)*0.1) ? slope : 0.0;
}

// Blending and neighbourhood statistics in a tonemapped space: a few very bright HDR pixels
// (highlights, sparks, sun on water) otherwise dominate the averages and flicker.
float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
vec3 tonemap(vec3 c) { c = max(c, vec3(0.0)); return c / (1.0 + luma(c)); }
vec3 untonemap(vec3 c) { return c / max(1.0 - luma(c), 1e-4); }
vec3 toYCoCg(vec3 c) {
    return vec3(dot(c, vec3(0.25, 0.5, 0.25)), dot(c, vec3(0.5, 0.0, -0.5)),
                dot(c, vec3(-0.25, 0.5, -0.25)));
}
vec3 fromYCoCg(vec3 c) { return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

// Moves `history` towards `center` until it is inside the box (clamping per channel instead
// shifts its hue and changes with every jitter phase).
vec3 clipToBox(vec3 history, vec3 center, vec3 lo, vec3 hi) {
    vec3 extent = max(0.5 * (hi - lo), vec3(1e-5));
    vec3 offset = history - 0.5 * (hi + lo);
    vec3 units = abs(offset / extent);
    float m = max(units.x, max(units.y, units.z));
    return m > 1.0 ? 0.5 * (hi + lo) + offset / m : history;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(result_img);
    if (any(greaterThanEqual(p, size))) return;
    const uint diag = pad & 0xffu, variant = (pad >> 8) & 0xffu;
    // Pad bit 25: tonemapped 8-bit scene colour (God of War III): variance clipping in YCoCg and
    // less history on moving pixels; the HDR game's A/B findings do not apply to it.
    const bool ldr = (pad & (1u << 25)) != 0u;
    vec2 current_pos = vec2(p) + jitter;
    ivec2 color_source = clamp(ivec2(floor(current_pos + 0.5)), ivec2(0), size - 1);
    ivec2 source = color_source;
    // Neighbourhood of the current pixel: the RGB min/max box (history clamp), and for the
    // optional techniques below its tonemapped YCoCg box, moments and a jitter-aware 3x3
    // reconstruction (a Blackman-Harris fit, as in UE4).
    vec3 rgb_lo = vec3(1e9), rgb_hi = vec3(-1e9);
    vec3 filtered = vec3(0.0), moment1 = vec3(0.0), moment2 = vec3(0.0);
    vec3 lo = vec3(1e9), hi = vec3(-1e9);
    float filter_weight = 0.0;
    // Luma of the eight neighbours of the source pixel (tonemapped), for the sparkle filter.
    float hi1 = -1.0, hi2 = -1.0, lo1 = 1e9, lo2 = 1e9, nsum = 0.0, nsum2 = 0.0;
    const bool use_filter = (variant & 8u) != 0u;
    const bool use_bicubic = ldr && !use_filter && (variant & 64u) == 0u;
    // One pass over the 4x4 block of the Catmull-Rom resampling. The 3x3 neighbourhood of
    // color_source lies inside it (the jitter is within half a pixel), so every texel is read once.
    const ivec2 cbase = ivec2(floor(current_pos)) - 1;
    const ivec2 win = clamp(color_source - 1 - cbase, ivec2(0), ivec2(1)); // where the 3x3 starts
    float cwx[4], cwy[4];
    catmullRomWeights(current_pos - floor(current_pos), cwx, cwy);
    vec3 bicubic_sum = vec3(0.0);
    float tl[16]; // tonemapped luma of the block
    for (int fy = 0; fy < 4; ++fy)
        for (int fx = 0; fx < 4; ++fx) {
            vec3 c = texelFetch(color_tex, clamp(cbase + ivec2(fx, fy), ivec2(0), size - 1), 0).rgb;
            bicubic_sum += c * (cwx[fx] * cwy[fy]);
            if (any(isnan(c)) || any(isinf(c))) c = vec3(0.0);
            const vec3 t = tonemap(c);
            const float l = luma(t);
            tl[fy * 4 + fx] = l;
            const ivec2 rel = ivec2(fx, fy) - win; // position in the 3x3
            if (all(greaterThanEqual(rel, ivec2(0))) && all(lessThanEqual(rel, ivec2(2)))) {
                rgb_lo = min(rgb_lo, c);
                rgb_hi = max(rgb_hi, c);
                if (use_filter) {
                    vec2 d = vec2(cbase + ivec2(fx, fy)) - current_pos;
                    float w = exp(-2.29 * dot(d, d));
                    filtered += t * w;
                    filter_weight += w;
                }
                if (rel != ivec2(1)) {
                    nsum += l;
                    nsum2 += l * l;
                    if (l > hi1) { hi2 = hi1; hi1 = l; } else if (l > hi2) { hi2 = l; }
                    if (l < lo1) { lo2 = lo1; lo1 = l; } else if (l < lo2) { lo2 = l; }
                }
                vec3 s = toYCoCg(t);
                moment1 += s;
                moment2 += s * s;
                lo = min(lo, s);
                hi = max(hi, s);
            }
        }
    // Tonemapped luma of the 3x3 (the dynamic-object test and the edge smoothing use it again).
    float cw[9];
    for (int b = 0; b < 3; ++b)
        for (int a = 0; a < 3; ++a)
            cw[b * 3 + a] = win.y == 0 ? (win.x == 0 ? tl[b * 4 + a] : tl[b * 4 + a + 1])
                                       : (win.x == 0 ? tl[(b + 1) * 4 + a] : tl[(b + 1) * 4 + a + 1]);
    // Catmull-Rom instead of bilinear to undo the jitter: the bilinear one softens the picture
    // by half a pixel every frame; the neighbourhood box keeps the overshoot in check.
    vec3 current = use_bicubic ? clamp(max(bicubic_sum, vec3(0.0)), rgb_lo, rgb_hi)
                 : use_filter ? untonemap(filtered / filter_weight)
                              : fetchLinear(color_tex, current_pos).rgb;
    // Sparkle filter, 0-2 (0-200%): up to 1 it pulls a pixel no neighbour shares towards the second
    // brightest / darkest neighbour; 1-2 also limits it to the neighbours' mean +- k sigma (k from 3
    // down to 1.2), so a glint of several pixels is cut too. Detail hold, 0-1 (below, `flick`): holds
    // more history on high-contrast fine detail.
    const float sparkle = float((reset_history >> 8) & 0xffu) * 0.02;
    const float spark_stat = clamp(sparkle - 1.0, 0.0, 1.0);
    const float spark_hold = float((reset_history >> 16) & 0xffu) * 0.01;
    if (ldr && sparkle > 0.0) {
        vec3 t = tonemap(current);
        const float l = luma(t);
        float bright_limit = hi2, dark_limit = lo2;
        if (spark_stat > 0.0) {
            const float mean8 = nsum * 0.125;
            const float sd8 = sqrt(max(nsum2 * 0.125 - mean8 * mean8, 0.0));
            const float k = mix(3.0, 1.2, spark_stat);
            bright_limit = min(hi2, mean8 + k * sd8);
            dark_limit = max(lo2, mean8 - k * sd8);
        }
        const float amount = spark_stat > 0.0 ? 1.0 : min(sparkle, 1.0);
        if (l > bright_limit) {
            t *= mix(1.0, bright_limit / max(l, 1e-4), amount);
        } else if (l < dark_limit) {
            t += vec3(mix(0.0, dark_limit - l, amount));
        }
        current = untonemap(t);
    }
    rgb_lo = min(rgb_lo, current);
    rgb_hi = max(rgb_hi, current);
    lo = min(lo, toYCoCg(tonemap(current)));
    hi = max(hi, toYCoCg(tonemap(current)));
    // High-contrast fine detail (chains, grates, far textures) is where the flicker lives.
    const float flick = ldr ? spark_hold * smoothstep(0.12, 0.45, hi.x - lo.x) : 0.0;
    float depth = texelFetch(depth_tex, source, 0).r;
    // Dilate foreground depth/motion, as temporal upscalers do. Thin geometry can
    // alternate with background under jitter; a 3x3 nearest surface remains trackable.
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) {
            if (x == 0 && y == 0) continue; // the centre is where `depth` started
            ivec2 candidate = clamp(color_source+ivec2(x,y),ivec2(0),size-1);
            float candidate_depth = texelFetch(depth_tex,candidate,0).r;
            if (candidate_depth < depth) {
                depth = candidate_depth;
                source = candidate;
            }
        }
    if (depth < 1.0) {
        vec2 slope = vec2(depthSlope(depth,source,ivec2(1,0),size),
                          depthSlope(depth,source,ivec2(0,1),size));
        depth = clamp(depth + dot(current_pos-vec2(source),slope),0.0,1.0-1e-7);
    }
    vec3 result = current;
    bool dyn_flag = false; // history alpha sign: this pixel looked like a mover this frame
    float history_weight = 0.0;
    vec3 debug_view = vec3(1.0, 0.0, 0.0); // diag 4: red = no history (or depth-rejected, see below)
    vec3 diagnostic_history = current;
    vec3 diagnostic_sample = current;
    vec3 diagnostic_direct = current;
    float diagnostic_displacement = 0.0;
    // Do not sample undefined history on reset, including the first dispatch after resizing.
    if ((reset_history & 1u) == 0u) {
        vec2 motion = texelFetch(motion_tex, source, 0).rg;
        vec2 previous_pos = vec2(p) + motion;
        if (diag != 0) {
            diagnostic_direct = texelFetch(history_tex,p,0).rgb;
            diagnostic_displacement = length(previous_pos-vec2(p));
        }
        if (!any(isnan(motion)) && !any(isinf(motion)) &&
            all(greaterThanEqual(previous_pos, vec2(0))) &&
            all(lessThanEqual(previous_pos, vec2(size - 1)))) {
            float expected_depth = expectedPreviousDepth(depth, current_pos, size);
            // Validate each bilinear tap separately: interpolating foreground/background
            // depth invents a surface and causes history rejection along thin edges.
            // Separate the integer pixel from the subpixel motion before interpolation.
            // Adding tiny motion to a large coordinate first loses fractional precision.
            vec2 integer_motion = floor(motion);
            ivec2 base = p + ivec2(integer_motion);
            vec2 fraction = motion - integer_motion;
            vec3 history_rgb = vec3(0.0);
            float coverage = 0.0;
            float threshold = max(2e-7, abs(prev_proj.z - expected_depth) * 0.02);
            // One pass over the 4x4 block around the motion-displaced position: the 2x2 taps that are
            // validated, the Catmull-Rom footprint, and the 3x3 patch of the dynamic-object test all lie
            // inside it, so every history texel is read once.
            const bool want_dyn = ldr && (variant & 128u) == 0u;
            vec2 hist_position = vec2(base) + fraction;
            float hwx[4], hwy[4];
            catmullRomWeights(hist_position - floor(hist_position), hwx, hwy);
            vec3 sharp_sum = vec3(0.0);
            float hl[16];      // tonemapped luma of the block
            uint fired_bits = 0u; // sign of the history alpha (a mover was detected there last frame)
            for (int fy = 0; fy < 4; ++fy)
                for (int fx = 0; fx < 4; ++fx) {
                    vec4 tap = texelFetch(history_tex,
                        clamp(base + ivec2(fx - 1, fy - 1), ivec2(0), size - 1), 0);
                    sharp_sum += tap.rgb * (hwx[fx] * hwy[fy]);
                    if (want_dyn) {
                        hl[fy * 4 + fx] = luma(tonemap(tap.rgb));
                        fired_bits |= (floatBitsToUint(tap.a) >> 31) << uint(fy * 4 + fx);
                    }
                    if (fx < 1 || fx > 2 || fy < 1 || fy > 2) continue;
                    // Validate each bilinear tap separately: interpolating foreground/background
                    // depth invents a surface and causes history rejection along thin edges.
                    // Separate the integer pixel from the subpixel motion before interpolation.
                    // Adding tiny motion to a large coordinate first loses fractional precision.
                    const int x = fx - 1, y = fy - 1;
                    float w = (x == 0 ? 1.0 - fraction.x : fraction.x) *
                              (y == 0 ? 1.0 - fraction.y : fraction.y);
                    bool same_surface = depth >= 1.0 ? abs(tap.a) >= 1.0 :
                        abs(tap.a) < 1.0 && abs(abs(tap.a) - expected_depth) <= threshold;
                    // When nothing moves, history in front of the current surface stays:
                    // a thin surface (railing, window bars) that this jitter phase missed
                    // otherwise blinks with the jitter sequence (static-camera flicker p99.9
                    // -45%, 2026-10-03). An object that moved away is bounded by the colour clip
                    // below, as in TAA without depth rejection. Variant bit 16: the old rule.
                    if (!same_surface && (variant & 16u) == 0u && length(motion) < 1.0 &&
                        abs(tap.a) < expected_depth && expected_depth < 1.0)
                        same_surface = true;
                    if (same_surface && !any(isnan(tap)) && !any(isinf(tap))) {
                        history_rgb += tap.rgb * w;
                        coverage += w;
                    }
                }
            // Conservatively discard newly revealed surfaces. RGB clipping handles animated
            // objects lacking object vectors, transparent effects and lighting changes.
            if (expected_depth >= 0.0 && coverage > 0.01) {
                diagnostic_sample = history_rgb / coverage;
                if (coverage > 0.99 && (variant & 32u) == 0u) {
                    // The 4x4 footprint reaches taps the check above did not look at: a bad value
                    // there keeps the validated bilinear sample.
                    vec3 sharp_history = max(sharp_sum, vec3(0.0));
                    if (!any(isnan(sharp_history)) && !any(isinf(sharp_history)))
                        diagnostic_sample = sharp_history;
                }
                float moving = clamp(length(motion) / (ldr ? 4.0 : 8.0), 0.0, 1.0);
                float clip_error = 0.0;
                vec3 clipped;
                if (ldr || (variant & 2u) != 0u) {
                    // Clip towards the box centre in tonemapped YCoCg (no hue shift), within
                    // mean +- gamma * sigma with variance clipping (Salvi).
                    vec3 box_lo = lo, box_hi = hi;
                    if (ldr || (variant & 4u) != 0u) {
                        vec3 mean = moment1 / 9.0;
                        vec3 sigma = sqrt(max(moment2 / 9.0 - mean * mean, vec3(0.0)));
                        float gamma = ldr ? mix(prev_proj.w, prev_proj.w * 0.72, moving) : mix(1.25, 0.9, moving);
                        gamma *= 1.0 + 0.6 * flick;
                        box_lo = max(lo, mean - gamma * sigma);
                        box_hi = min(hi, mean + gamma * sigma);
                    }
                    vec3 history_y = toYCoCg(tonemap(diagnostic_sample));
                    vec3 clipped_y = clipToBox(history_y, vec3(0.0), box_lo, box_hi);
                    clip_error = length(history_y - clipped_y);
                    clipped = untonemap(fromYCoCg(clipped_y));
                } else {
                    clipped = clamp(diagnostic_sample, rgb_lo, rgb_hi);
                }
                diagnostic_history = clipped;
                // Reliable history suppresses subpixel shimmer even on distant geometry.
                // LDR: history that had to be clipped far (a moving object without a motion vector, a
                // lighting change) is less trusted, which removes the smear behind characters.
                float confidence = ldr ? 1.0 - clamp(clip_error * proj.w, 0.0, 0.75) * (1.0 - 0.5 * flick) : 1.0;
                if (ldr && (variant & 128u) == 0u) {
                    // Objects without motion vectors (characters, foliage): a slow mover stays inside
                    // the neighbourhood box and passes the depth test, so its history smears. The
                    // 3x3 patch of the history differs from the current one far more than jitter
                    // noise makes it differ on a static picture (sim: 0.09 against 0.01 luma);
                    // such pixels trust the history less. Variant bit 128 turns this off.
                    const ivec2 ro = ivec2(round(fraction)); // where the 3x3 patch starts in the block
                    float diff = 0.0;
                    for (int b = 0; b < 3; ++b)
                        for (int a = 0; a < 3; ++a) {
                            const float h = ro.y == 0 ? (ro.x == 0 ? hl[b * 4 + a] : hl[b * 4 + a + 1])
                                                      : (ro.x == 0 ? hl[(b + 1) * 4 + a] : hl[(b + 1) * 4 + a + 1]);
                            diff += abs(cw[b * 3 + a] - h);
                        }
                    float changed = smoothstep(0.04, 0.10, diff / 9.0);
                    dyn_flag = changed >= 0.5;
                    // The jitter makes textured pixels look "changed" now and then (flicker if their
                    // history is dropped then); a real mover changes frame after frame. A pixel with no
                    // changed neighbour in the last frame (the sign of the history alpha) is trusted more.
                    const uint row = 0x7u << uint(ro.x);
                    const uint patch_bits = (row | (row << 4) | (row << 8)) << uint(4 * ro.y);
                    const bool fired_before = (fired_bits & patch_bits) != 0u;
                    if (!fired_before) changed *= 0.3;
                    changed *= 1.0 - 0.7 * flick;
                    confidence *= 1.0 - float((pad >> 16) & 0xffu) * 0.01 * changed;
                }
                float weight = (ldr ? mix(prev_proj.x, mix(prev_proj.y, max(prev_proj.y, 0.9), flick), moving)
                             : mix(0.98, 0.85, moving)) *
                               coverage * confidence;
                history_weight = weight;
                // diag 4: red = depth-rejected share, green = history lost to colour change / moving
                // object detection, blue = history weight finally used.
                debug_view = vec3(1.0 - coverage, 1.0 - confidence, weight);
                // Tonemapped blending: a few very bright HDR samples otherwise dominate.
                result = (variant & 1u) != 0u
                             ? untonemap(mix(tonemap(current), tonemap(clipped), weight))
                             : mix(current, clipped, weight);
            }
        }
    }
    vec3 shown = result;
    const float spatial = float(pad >> 26) * (1.0 / 63.0);
    if (ldr && spatial > 0.0) {
        // Spatial fallback where the history was (partly) refused: a moving object has no AA from
        // time, so smooth its stair-stepped edges from the current picture alone.
        float need = clamp((0.75 - history_weight) / 0.5, 0.0, 1.0);
        if (need > 0.0) {
            float l[9] = cw;
            float gx = (l[2] + 2.0 * l[5] + l[8]) - (l[0] + 2.0 * l[3] + l[6]);
            float gy = (l[6] + 2.0 * l[7] + l[8]) - (l[0] + 2.0 * l[1] + l[2]);
            float mag = length(vec2(gx, gy));
            float edge = smoothstep(0.1, 0.1 * 3.0, mag);
            if (edge > 0.0) {
                vec2 n = vec2(gx, gy) / mag;
                vec3 a = fetchLinear(color_tex, current_pos + n * 0.5).rgb;
                vec3 b = fetchLinear(color_tex, current_pos - n * 0.5).rgb;
                vec3 sp = clamp((current * 1.0 + a + b) / (1.0 + 2.0), rgb_lo, rgb_hi);
                shown = mix(result, sp, need * edge * spatial);
            }
        }
    }
    // Optional diagnostic alpha; normal output remains opaque.
    vec3 output_color = diag == 2 ? current : diag == 3 ? diagnostic_history : diag == 4 ? debug_view : shown;
    // The diagnostic views reach the screen with red and blue exchanged (checked with a pure red/blue swatch:
    // the swap is in how the scene image is written back; the normal picture is not affected, as it
    // is read through the same exchange). Exchanged here, so a view shows the colours described.
    if (diag != 0) output_color = output_color.bgr;
    imageStore(result_img, p, vec4(output_color, diag != 0 ? history_weight : 1.0));
    imageStore(next_history, p, vec4(result, dyn_flag ? -depth : depth));
    if (diag != 0) imageStore(diagnostic_img,p,
        vec4(diag == 2 ? diagnostic_direct : diagnostic_history,
             diag == 2 ? diagnostic_displacement : history_weight));
}
