// spartanport: reactive mask for XeSS and FSR 3.1 from what moved without a motion vector.
//
// Characters and other animated objects have no motion vectors of their own (only the camera's), so
// an upscaler's history smears behind them. The stencil mask marks them, but only where the stencil
// says so. This pass finds them the way taa.comp does: the 3x3 patch of the current frame is compared
// with the same patch of a slowly updated reference of the previous frames, reprojected with the
// camera motion. A still or panned picture agrees with it (the jitter only makes a little noise); a
// pixel that changed on its own does not.
//
// The reference is a luma image of its own, updated every frame (half a frame of the new value on a
// still pixel, all of it where the picture changed so it does not smear). The mask is combined with
// the stencil mask already in `reactive` when bit 1 of `flags` is set.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D color_tex;  // the jittered LDR scene
layout(binding = 1) uniform sampler2D motion_tex; // previous minus current position, in pixels
layout(binding = 2) uniform sampler2D ref_tex;    // the previous reference luma (clamp, linear)
layout(binding = 3, r16f) uniform writeonly image2D ref_out;
layout(binding = 4, r8) uniform image2D reactive;

layout(push_constant) uniform Params {
    float strength; // reactivity of a changed pixel, 0..1
    uint flags;     // bit 0: no reference yet (reset); bit 1: keep the mask in `reactive`; bit 2: linear colour
    float lo;       // the 3x3 mean luma difference where the mask starts
    float hi;       // ... and where it is full
};

float luma(vec3 c) {
    // The tonemapped scene is 8-bit sRGB; through an sRGB view the values are linear: back to a
    // perceptual scale so the thresholds mean the same for both.
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return (flags & 4u) != 0u ? sqrt(max(l, 0.0)) : l;
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(reactive);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    const vec2 mv = texelFetch(motion_tex, pixel, 0).xy;
    const float current = luma(texelFetch(color_tex, pixel, 0).rgb);
    float mask = 0.0;
    float reference = current;
    if ((flags & 1u) == 0u) {
        float diff = 0.0;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                const ivec2 at = pixel + ivec2(x, y);
                const float c = luma(texelFetch(color_tex, clamp(at, ivec2(0), size - 1), 0).rgb);
                const float r = textureLod(ref_tex, (vec2(at) + 0.5 + mv) / vec2(size), 0.0).r;
                diff += abs(c - r);
            }
        }
        const float changed = smoothstep(lo, hi, diff / 9.0);
        const float before = textureLod(ref_tex, (vec2(pixel) + 0.5 + mv) / vec2(size), 0.0).r;
        reference = mix(before, current, mix(0.5, 1.0, changed));
        mask = changed * strength;
    }
    imageStore(ref_out, pixel, vec4(reference));
    const float kept = (flags & 2u) != 0u ? imageLoad(reactive, pixel).r : 0.0;
    imageStore(reactive, pixel, vec4(max(kept, mask)));
}
