// spartanport: copies the game's alpha into the upscaler's RGBA16F result before it is blitted back
// into the 8-bit scene colour (the post-processing may keep data in alpha).
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D scene_tex; // the scene colour, nearest
layout(binding = 1, rgba16f) uniform image2D result_img;
layout(binding = 2) uniform texture2D mask_tex; // FSR's reactive mask (only read in debug mode 1)

layout(push_constant) uniform Params {
    uint mode; // 1: show the reactive mask in red over a darkened picture
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(result_img)))) {
        return;
    }
    const vec4 result = imageLoad(result_img, pixel);
    const float alpha = texelFetch(scene_tex, pixel, 0).a;
    vec3 color = clamp(result.rgb, 0.0, 1.0);
    if (mode == 1u) {
        const float mask = texelFetch(mask_tex, pixel, 0).r;
        color = mix(color * 0.25, vec3(1.0, 0.0, 0.0), mask);
    }
    imageStore(result_img, pixel, vec4(color, alpha));
}
