// spartanport: reactive mask for FSR 3.1 on God of War III's tonemapped frame.
//
// The game gives objects such as characters no motion vectors, so FSR keeps their history and smears
// them. The current frame is compared with FSR's own result of the last frame (the accumulated, almost
// aliasing-free picture). A static pixel differs from it by little, even on a jittered aliased texture
// (sim: 0.01 luma), a mover by far more (0.09); the 3x3 patch average of the difference decides.
// The difference is taken on tonemapped linear luma, as in the TAA detector: a relative difference
// (tried in test27) fires on the 8-bit quantisation and dither noise of dark textures and made the
// whole static picture flicker.
// A pixel only counts as a mover when a neighbour was flagged in the last frame too: jitter makes
// textured pixels fire now and then, a real mover fires frame after frame.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D color_tex;     // this frame's scene colour (linear)
layout(binding = 1) uniform texture2D previous_tex;  // FSR's result of the last frame
layout(binding = 2) uniform texture2D motion_tex;    // camera motion in pixels (towards the last frame)
layout(binding = 3, r8) uniform writeonly image2D reactive_img;
layout(binding = 4) uniform texture2D previous_flag_tex;
layout(binding = 5, r8) uniform writeonly image2D flag_img;

layout(push_constant) uniform Constants {
    vec2 sample_shift; // pixels: where this frame's jittered samples sit relative to the pixel grid
    float low;         // luma difference where the mask starts
    float high;        // luma difference where it is full
    float gain;
    float cap;         // largest mask value (0..1)
    float persist;     // mask share kept when no neighbour was flagged in the last frame
    float enabled;     // 0: no previous result (first frame, reset): mask off
};

vec3 tonemap(vec3 c) {
    return c / (1.0 + max(c.r, max(c.g, c.b)));
}

float luma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(reactive_img);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    if (enabled < 0.5) {
        imageStore(reactive_img, p, vec4(0.0));
        imageStore(flag_img, p, vec4(0.0));
        return;
    }
    const vec2 motion = texelFetch(motion_tex, p, 0).rg;
    const ivec2 q = p + ivec2(floor(motion + sample_shift + 0.5));
    float diff = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            const float c = luma(tonemap(texelFetch(color_tex, clamp(p + ivec2(x, y), ivec2(0), size - 1), 0).rgb));
            const float h = luma(tonemap(texelFetch(previous_tex, clamp(q + ivec2(x, y), ivec2(0), size - 1), 0).rgb));
            diff += abs(c - h);
        }
    }
    float changed = smoothstep(low, high, diff / 9.0);
    const bool fired = changed >= 0.5;
    bool before = false;
    for (int y = -1; y <= 1 && !before; ++y) {
        for (int x = -1; x <= 1; ++x) {
            if (texelFetch(previous_flag_tex, clamp(q + ivec2(x, y), ivec2(0), size - 1), 0).r > 0.5) {
                before = true;
            }
        }
    }
    if (!before) {
        changed *= persist;
    }
    imageStore(flag_img, p, vec4(fired ? 1.0 : 0.0));
    imageStore(reactive_img, p, vec4(min(changed * gain, cap)));
}
