// spartanport: smooths the stair-stepped edges of moving characters in FSR's result.
//
// Where the reactive mask refuses FSR's history, a mover has no anti-aliasing from time: its edges show
// the single jittered sample of the current frame. There (and only there) the picture is smoothed along
// the edge normal with a 3-tap filter, as the TAA does. The input is FSR's unfiltered result (the copy kept
// as next frame's reference), so nothing filtered ever enters the history.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D result_tex; // FSR's result, unfiltered
layout(binding = 1) uniform texture2D mask_tex;   // the reactive mask
layout(binding = 2, rgba16f) uniform writeonly image2D out_img;

layout(push_constant) uniform Constants {
    float strength; // 0..1
};

vec3 tonemap(vec3 c) {
    return c / (1.0 + max(c.r, max(c.g, c.b)));
}

float luma(vec3 c) {
    return dot(c, vec3(0.299, 0.587, 0.114));
}

vec3 fetch(ivec2 p, ivec2 size) {
    return texelFetch(result_tex, clamp(p, ivec2(0), size - 1), 0).rgb;
}

// Bilinear sample at a position in pixels (pixel centres at +0.5).
vec3 fetchLinear(vec2 position, ivec2 size) {
    const vec2 shifted = position - 0.5;
    const ivec2 base = ivec2(floor(shifted));
    const vec2 f = shifted - vec2(base);
    return mix(mix(fetch(base, size), fetch(base + ivec2(1, 0), size), f.x),
               mix(fetch(base + ivec2(0, 1), size), fetch(base + ivec2(1, 1), size), f.x), f.y);
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(out_img);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    const vec3 center = fetch(p, size);
    vec3 shown = center;
    const float need = clamp(texelFetch(mask_tex, p, 0).r / 0.6, 0.0, 1.0);
    if (need > 0.0 && strength > 0.0) {
        float l[9];
        vec3 lo = center, hi = center;
        for (int y = -1; y <= 1; ++y) {
            for (int x = -1; x <= 1; ++x) {
                const vec3 c = fetch(p + ivec2(x, y), size);
                l[(y + 1) * 3 + x + 1] = luma(tonemap(c));
                lo = min(lo, c);
                hi = max(hi, c);
            }
        }
        const float gx = (l[2] + 2.0 * l[5] + l[8]) - (l[0] + 2.0 * l[3] + l[6]);
        const float gy = (l[6] + 2.0 * l[7] + l[8]) - (l[0] + 2.0 * l[1] + l[2]);
        const float mag = length(vec2(gx, gy));
        const float edge = smoothstep(0.1, 0.3, mag);
        if (edge > 0.0) {
            const vec2 n = vec2(gx, gy) / mag;
            const vec2 at = vec2(p) + 0.5;
            const vec3 a = fetchLinear(at + n * 0.5, size);
            const vec3 b = fetchLinear(at - n * 0.5, size);
            const vec3 smooth_color = clamp((center + a + b) / 3.0, lo, hi);
            shown = mix(center, smooth_color, need * edge * strength);
        }
    }
    imageStore(out_img, p, vec4(shown, 1.0));
}
