// spartanport: the game's depth (offset + scale * clip z / w, here 0.5..1) as the plain clip z / w that
// FSR expects, in an R32F image.
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform texture2D depth_tex;
layout(binding = 1, r32f) uniform writeonly image2D result_img;

layout(push_constant) uniform Constants {
    vec2 range; // scale, offset
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(result_img)))) {
        return;
    }
    const float depth = texelFetch(depth_tex, pixel, 0).r;
    imageStore(result_img, pixel, vec4(clamp((depth - range.y) / range.x, 0.0, 1.0)));
}
